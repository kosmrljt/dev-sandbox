#!/usr/bin/env bash
# td32-import - Borland/Delphi/C++Builder binary: real procedure names from its TD32
#               debug info, into the project's Ghidra project (headless).
#
# Usage:  td32-import [id|program.exe] [--skip-analysis]
#   --skip-analysis  skip Ghidra auto-analysis (fast; only creates functions from TD32)
#
# Run it before exportjson.sh; the export then carries the names (outq info:
# "qualified" > 0). re init does both for a Delphi binary with TD32.
# For a project ALREADY open in Ghidra: Script Manager -> category Delphi ->
# td32_ghidra.py (needs Ghidra in PyGhidra mode).
# Without Ghidra at all:  td32_ghidra.py check|extract program.exe
set -euo pipefail
ARG=""
SKIP=()
for a in "$@"; do
    case "$a" in
        --skip-analysis) SKIP=(--skip-analysis) ;;
        *) ARG="$a" ;;
    esac
done
IFS=$'\t' read -r ID BIN < <(re resolve "$ARG")
[[ -f "$BIN" ]] || { echo "No such file: $BIN" >&2; exit 1; }
HERE="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"

# Quick sanity check first (does it have TD32, how many procs, do names parse).
python3 "$HERE/td32_ghidra.py" check "$BIN"

ghidra-run "${SKIP[@]}" "$ID" "$HERE/td32_ghidra.py" "$BIN"
echo "Next: exportjson.sh $ID"
