#!/usr/bin/env bash
# td32-import - import a Borland/Delphi .exe into a FRESH Ghidra project (headless)
#               and pull in the procedure names from its TD32 debug info.
#
# Usage:  td32-import <program.exe> [project_dir] [--skip-analysis]
#   project_dir      default: next to the program (<program>_ghidra)
#   --skip-analysis  skip Ghidra auto-analysis (fast; only creates functions from TD32)
#
# For a project ALREADY open in Ghidra: Script Manager (the image has /opt/scripts on the
# Ghidra script path) -> category Delphi -> td32_ghidra.py. Running it from the GUI needs
# Ghidra in PyGhidra mode; this headless wrapper uses the `pyghidra` launcher instead.
# Without Ghidra at all:  td32_ghidra.py check|extract program.exe
set -euo pipefail
BIN="${1:?usage: td32-import <program.exe> [project_dir] [--skip-analysis]}"
shift
PROJ=""
SKIP=()
for a in "$@"; do
    case "$a" in
        --skip-analysis) SKIP=(--skip-analysis) ;;
        *) PROJ="$a" ;;
    esac
done
[[ -f "$BIN" ]] || { echo "No such file: $BIN" >&2; exit 1; }
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export GHIDRA_INSTALL_DIR="${GHIDRA_INSTALL_DIR:-${GHIDRA_HOME:-/opt/ghidra}}"

# Quick sanity check first (does it have TD32, how many procs, do names parse).
python3 "$HERE/td32_ghidra.py" check "$BIN"

# Then import + analyze via the pyghidra launcher, running td32_ghidra.py against the program.
ARGS=("${SKIP[@]}")
[[ -n "$PROJ" ]] && { mkdir -p "$PROJ"; ARGS+=(--project-path "$PROJ"); }
pyghidra "${ARGS[@]}" "$BIN" "$HERE/td32_ghidra.py" "$(realpath "$BIN")"
